---
interface Props {
  title?: string;
  description?: string;
}

const { title = 'Daily Verse', description = 'One verse, one reflection, every morning.' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />
    <title>{title === 'Daily Verse' ? title : `${title} — Daily Verse`}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --ink: #1a1a1a;
        --muted: #666;
        --faint: #e8e4de;
        --bg: #faf8f5;
        --accent: #8b6f47;
        --max-w: 42rem;
        --serif: Georgia, 'Times New Roman', serif;
        --sans: system-ui, -apple-system, sans-serif;
      }

      html { background: var(--bg); color: var(--ink); font-family: var(--sans); }

      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        padding: 0 1.25rem;
      }

      header {
        padding: 2rem 0 1.5rem;
        max-width: var(--max-w);
        margin: 0 auto;
        width: 100%;
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        border-bottom: 1px solid var(--faint);
      }

      header a { text-decoration: none; color: inherit; }

      .site-name {
        font-family: var(--serif);
        font-size: 1.1rem;
        font-weight: normal;
        letter-spacing: 0.04em;
        color: var(--accent);
      }

      nav { display: flex; gap: 1.5rem; }

      nav a {
        font-size: 0.85rem;
        color: var(--muted);
        text-decoration: none;
        letter-spacing: 0.03em;
      }

      nav a:hover { color: var(--ink); }

      main {
        flex: 1;
        max-width: var(--max-w);
        margin: 0 auto;
        width: 100%;
        padding: 3rem 0 4rem;
      }

      footer {
        max-width: var(--max-w);
        margin: 0 auto;
        width: 100%;
        padding: 1.5rem 0 2rem;
        border-top: 1px solid var(--faint);
        font-size: 0.75rem;
        color: var(--muted);
        text-align: center;
      }
    </style>
  </head>
  <body>
    <header>
      <a href="/"><span class="site-name">Daily Verse</span></a>
      <nav>
        <a href="/">Today</a>
        <a href="/archive">Archive</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      One verse, one reflection, every morning.
    </footer>
  </body>
</html>
