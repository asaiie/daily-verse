---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const entries = await getCollection('entries');
const sorted = entries.sort((a, b) => b.data.date.localeCompare(a.data.date));

function formatDate(dateStr: string) {
  const [year, month, day] = dateStr.split('-').map(Number);
  return new Date(year, month - 1, day).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

// Group by year
const byYear = new Map<string, typeof sorted>();
for (const entry of sorted) {
  const year = entry.data.date.split('-')[0];
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(entry);
}
const years = [...byYear.keys()].sort((a, b) => b.localeCompare(a));
---

<Layout title="Archive" description="All Daily Verse entries, newest first.">
  <h1 class="page-title">Archive</h1>

  {years.length === 0 ? (
    <p class="empty">No entries yet.</p>
  ) : (
    years.map(year => (
      <section class="year-group">
        <h2 class="year-label">{year}</h2>
        <ul class="entry-list">
          {byYear.get(year)!.map(entry => (
            <li class="entry-row">
              <a href={`/${entry.slug}`} class="entry-link">
                <span class="entry-date">{formatDate(entry.data.date)}</span>
                <span class="entry-ref">{entry.data.verse_ref}</span>
                <span class="entry-themes">
                  {entry.data.themes.join(' · ')}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  )}
</Layout>

<style>
  .page-title {
    font-family: var(--serif);
    font-size: 1.4rem;
    font-weight: normal;
    color: var(--ink);
    margin-bottom: 2.5rem;
  }

  .year-group { margin-bottom: 2.5rem; }

  .year-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--faint);
  }

  .entry-list { list-style: none; }

  .entry-row { border-bottom: 1px solid var(--faint); }

  .entry-link {
    display: grid;
    grid-template-columns: 9rem 8rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding: 0.7rem 0;
    text-decoration: none;
    color: var(--ink);
    transition: background 0.1s;
  }

  .entry-link:hover { background: color-mix(in srgb, var(--accent) 4%, var(--bg)); }

  .entry-date {
    font-size: 0.82rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .entry-ref {
    font-family: var(--serif);
    font-size: 0.9rem;
    color: var(--accent);
    white-space: nowrap;
  }

  .entry-themes {
    font-size: 0.8rem;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .entry-link {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
    .entry-themes { display: none; }
  }

  .empty {
    color: var(--muted);
    font-size: 0.95rem;
    padding: 2rem 0;
  }
</style>
